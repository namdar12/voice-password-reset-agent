# Twilio (buy a voice-capable number at https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# AWS — Bedrock access for Amazon Nova Sonic (bidirectional streaming)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token_if_using_temporary_credentials
AWS_REGION=us-east-1

# Gmail — used to send password-reset verification codes
# (use an app-specific password: Google Account > Security > App passwords)
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password

# Redis — tracks active calls
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Server
HOST=0.0.0.0
PORT=8000
